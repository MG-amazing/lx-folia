{
  "openapi": "3.1.0",
  "info": {
    "title": "LX Folia KTV API",
    "version": "0.1.5",
    "description": "仅内网；管理员密码长期有效，修改立即失效。与 LX 原生稍后播放队列和 PC 队列面板同步。"
  },
  "servers": [
    {
      "url": "http://{host}:{port}",
      "variables": {
        "host": {
          "default": "127.0.0.1"
        },
        "port": {
          "default": "23330"
        }
      }
    }
  ],
  "security": [
    {
      "ApiPassword": []
    },
    {
      "BearerPassword": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiPassword": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "BearerPassword": {
        "type": "http",
        "scheme": "bearer",
        "description": "直接使用管理员设置的密码，不需要登录换 token"
      }
    }
  },
  "paths": {
    "/ktv/search": {
      "get": {
        "summary": "搜索歌曲",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "source",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "wy",
                "kw",
                "kg",
                "tx",
                "mg"
              ],
              "default": "wy"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1,
              "maximum": 100
            }
          }
        ]
      }
    },
    "/ktv/queue": {
      "get": {
        "summary": "待播队列",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        }
      },
      "post": {
        "summary": "点歌",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "musicId": {
                    "type": "string"
                  },
                  "top": {
                    "type": "boolean",
                    "default": false
                  }
                },
                "required": [
                  "musicId"
                ]
              }
            }
          }
        }
      }
    },
    "/ktv/queue/top": {
      "post": {
        "summary": "置顶",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "queueId": {
                    "type": "string"
                  }
                },
                "required": [
                  "queueId"
                ]
              }
            }
          }
        }
      }
    },
    "/ktv/queue/remove": {
      "post": {
        "summary": "移除",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "queueId": {
                    "type": "string"
                  }
                },
                "required": [
                  "queueId"
                ]
              }
            }
          }
        }
      }
    },
    "/ktv/next": {
      "post": {
        "summary": "切歌，空队列时暂停",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "summary": "LX 原生播放状态",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        }
      }
    },
    "/play": {
      "get": {
        "summary": "播放",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        }
      }
    },
    "/pause": {
      "get": {
        "summary": "暂停",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        }
      }
    },
    "/skip-next": {
      "get": {
        "summary": "LX 原生下一曲",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        }
      }
    }
  }
}