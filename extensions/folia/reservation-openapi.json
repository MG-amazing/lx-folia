{
  "openapi": "3.1.0",
  "info": {
    "title": "LX Folia Reservation API",
    "version": "0.1.5",
    "description": "仅内网；管理员密码长期有效，修改立即失效。与 LX 原生稍后播放队列和 PC 队列面板同步。"
  },
  "servers": [
    {
      "url": "http://{host}:{port}",
      "variables": {
        "host": {
          "default": "127.0.0.1"
        },
        "port": {
          "default": "23330"
        }
      }
    }
  ],
  "security": [
    {
      "ApiPassword": []
    },
    {
      "BearerPassword": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiPassword": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "BearerPassword": {
        "type": "http",
        "scheme": "bearer",
        "description": "直接使用管理员设置的密码，不需要登录换 token"
      }
    }
  },
  "paths": {
    "/reservation/search": {
      "get": {
        "summary": "搜索歌曲",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "source",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "wy",
                "kw",
                "kg",
                "tx",
                "mg"
              ],
              "default": "wy"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1,
              "maximum": 100
            }
          }
        ]
      }
    },
    "/reservation/queue": {
      "get": {
        "summary": "待播队列",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        }
      },
      "post": {
        "summary": "点歌",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "musicId": {
                    "type": "string"
                  },
                  "top": {
                    "type": "boolean",
                    "default": false
                  }
                },
                "required": [
                  "musicId"
                ]
              }
            }
          }
        }
      }
    },
    "/reservation/queue/top": {
      "post": {
        "summary": "置顶",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "queueId": {
                    "type": "string"
                  }
                },
                "required": [
                  "queueId"
                ]
              }
            }
          }
        }
      }
    },
    "/reservation/queue/remove": {
      "post": {
        "summary": "移除",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "queueId": {
                    "type": "string"
                  }
                },
                "required": [
                  "queueId"
                ]
              }
            }
          }
        }
      }
    },
    "/reservation/next": {
      "post": {
        "summary": "切歌，空队列时暂停",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "summary": "LX 原生播放状态",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        }
      }
    },
    "/play": {
      "get": {
        "summary": "播放",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        }
      }
    },
    "/pause": {
      "get": {
        "summary": "暂停",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        }
      }
    },
    "/skip-next": {
      "get": {
        "summary": "LX 原生下一曲",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数或操作失败"
          },
          "401": {
            "description": "密码缺失或错误"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "密码或播放器未就绪"
          }
        }
      }
    },
    "/reservation/status": {
      "get": {
        "summary": "获取当前歌曲与按顺序排列的全部待播预约",
        "responses": {
          "200": {
            "description": "nowPlaying 当前播放信息；queue 有序预约条目",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "nowPlaying",
                    "queue"
                  ],
                  "properties": {
                    "nowPlaying": {
                      "type": "object",
                      "properties": {
                        "musicId": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "name": {
                          "type": "string"
                        },
                        "singer": {
                          "type": "string"
                        },
                        "state": {
                          "type": "string",
                          "enum": [
                            "stopped",
                            "loading",
                            "playing",
                            "paused",
                            "error"
                          ]
                        },
                        "progress": {
                          "type": "number",
                          "description": "秒"
                        },
                        "duration": {
                          "type": "number",
                          "description": "秒"
                        }
                      }
                    },
                    "queue": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "queueId": {
                            "type": "string"
                          },
                          "musicId": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "singer": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "密码错误或缺失"
          },
          "403": {
            "description": "仅内网访问"
          },
          "503": {
            "description": "尚未配置密码或播放器未就绪"
          }
        }
      }
    }
  }
}